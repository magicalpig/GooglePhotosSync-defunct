{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch webserver",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/WebHelper/bin/Debug/net8.0-windows/WebHelper.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      /*"serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger/index.html"
      },*/
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5222"
      },
      "sourceFileMap": {
          "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch Vidprobe",
      "type": "coreclr",
      "request": "launch",      
      "program": "${workspaceFolder}/vidprobe/bin/Debug/net8.0-windows/vidprobe.dll",
      "args": [],
      "cwd": "${workspaceFolder}/vidprobe",
      "stopAtEntry": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "logging": {
        "moduleLoad": false,
        "trace": "verbose"
      },
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "justMyCode": false
    },
    {
      "name": "Build and Launch Vidprobe",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/vidprobe/bin/Debug/net8.0-windows/vidprobe.dll",
      "args": [],
      "cwd": "${workspaceFolder}/vidprobe",
      "stopAtEntry": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "logging": {
        "moduleLoad": false,
        "trace": "verbose"
      },
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "justMyCode": false
    },
    {
      "name": "Build and Launch jsonToDb",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/jsonToDb/bin/Debug/net8.0-windows/jsonToDb.dll",
      "args": [],
      "cwd": "${workspaceFolder}/jsonToDb",
      "stopAtEntry": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "logging": {
        "moduleLoad": false,
        "trace": true
      },
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "justMyCode": false
    }
  ]
}