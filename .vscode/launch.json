{
  "version": "0.2.0",
  "configurations": [

    {
      "name": "Launch webserver",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/WebHelper/bin/Debug/net8.0-windows/WebHelper.dll",
      "cwd": "${workspaceFolder}/WebHelper/bin/Debug/net8.0-windows/",
      "args": [],
      "stopAtEntry": false,
      /*"serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger/index.html"
      },*/
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5222"
      },
      "logging": {
        "moduleLoad": false,
        "trace": "verbose"
      },
      "sourceFileMap": {
          "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch Vidprobe",
      "type": "coreclr",
      "request": "launch",
      "cwd": "${workspaceFolder}/vidprobe/bin/Debug/net8.0-windows/",
      "program": "${workspaceFolder}/vidprobe/bin/Debug/net8.0-windows/vidprobe.dll",
      "args": [],
      "stopAtEntry": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "logging": {
        "moduleLoad": false,
        "trace": "verbose"
      },
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "justMyCode": false
    },
    {
      "name": "Launch Vidprobe Prodictopm",
      "type": "coreclr",
      "request": "launch",
      "cwd": "${workspaceFolder}/vidprobe/bin/Debug/net8.0-windows/",
      "program": "${workspaceFolder}/vidprobe/bin/Debug/net8.0-windows/vidprobe.dll",
      "args": [],
      "stopAtEntry": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "logging": {
        "moduleLoad": false,
        "trace": "verbose"
      },
      
      "justMyCode": false
    },
    {
      "name": "Build and Launch Vidprobe",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "cwd": "${workspaceFolder}/vidprobe/bin/Debug/net8.0-windows/",
      "program": "${workspaceFolder}/vidprobe/bin/Debug/net8.0-windows/vidprobe.dll",
      "args": [],      
      "stopAtEntry": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "logging": {
        "moduleLoad": false,
        "trace": "verbose"
      },
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "justMyCode": false
    }
  ]
}