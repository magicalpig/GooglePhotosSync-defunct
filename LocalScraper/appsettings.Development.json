{
  "Settings": {
    "FileLimit": 0,
    "FreshDatabase": false,
    "ForceMetadataRefresh": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "GoogleScraper": "Debug",
      "LocalScraper": "Debug",
      "WebHelper": "Debug"
    }, 
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "EnableColors": true
      }
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    },
    "Debug": {
      "LogLevel": {
        "Default": "None"
      }
    }
  }  
}
